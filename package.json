{
  "name": "aws-clf-c02-simulator",
  "version": "1.0.1",
  "private": true,
  "description": "AWS CLF-C02 Simulator para Windows",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "electron .",
    "test": "npm --prefix backend test && node --test electron/updateManager.test.js",
    "dist:win": "electron-builder --win nsis",
    "validate:release": "node scripts/validate-release.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.adriancotrim.awsclf.c02simulator",
    "productName": "AWS CLF-C02 Simulator",
    "artifactName": "AWS-CLF-C02-Simulator-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "index.html",
      "api.js",
      "app.js",
      "style.css",
      "data/questions.json",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "backend/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "AdrianCotrim",
      "repo": "AWS_CLF-C02_Simulator",
      "releaseType": "release"
    }
  }
}
